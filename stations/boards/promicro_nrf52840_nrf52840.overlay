#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * Example pin assignment for the Pro Micro nRF52840.
 * Verify these GPIOs against the exact board revision and your wiring.
 *
 * Buttons: connect each button between its GPIO and GND.
 * Internal pull-ups are enabled; pressed reads as logical 1.
 * LED output: drives a suitable MOSFET/transistor gate input, NOT the LED strip directly.
 */
 / {
    halloween_buttons {
        compatible = "gpio-keys";

        button1: button_1 {
            gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Answer 1";
        };

        button2: button_2 {
            gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Answer 2";
        };

        button3: button_3 {
            gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Answer 3";
        };
    };

    /*
     * Station 5 only: 4x3 code keypad, connector order R1..R4, C1..C3.
     * Rows are driven low one at a time; columns use internal pull-ups.
     * EXAMPLE pins, verify they are free/exposed on your board.
     */
    halloween_keypad {
        krow1: krow_1 { compatible = "halloween,gpio"; gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
        krow2: krow_2 { compatible = "halloween,gpio"; gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>; };
        krow3: krow_3 { compatible = "halloween,gpio"; gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>; };
        krow4: krow_4 { compatible = "halloween,gpio"; gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>; };

        kcol1: kcol_1 { compatible = "halloween,gpio"; gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; };
        kcol2: kcol_2 { compatible = "halloween,gpio"; gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>; };
        kcol3: kcol_3 { compatible = "halloween,gpio"; gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>; };
    };

    halloween_led: halloween_led {
        compatible = "halloween,gpio";
        gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
        label = "LED strip MOSFET enable";
    };
};


/*
 * LCD I2C controller configuration.
 * P0.08 SDA and P0.11 SCL are EXAMPLE pins only. Verify against the
 * exact Pro Micro board pinout and ensure they do not conflict with
 * the board's existing pinctrl configuration.
 */
&pinctrl {
    lcd_i2c0_default: lcd_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 8)>,
                    <NRF_PSEL(TWIM_SCL, 0, 11)>;
        };
    };

    lcd_i2c0_sleep: lcd_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 8)>,
                    <NRF_PSEL(TWIM_SCL, 0, 11)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&lcd_i2c0_default>;
    pinctrl-1 = <&lcd_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};
