#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * Example pin assignment for the Pro Micro nRF52840.
 * Verify these GPIOs against the exact board revision and your wiring.
 *
 * Buttons: connect each button between its GPIO and GND.
 * Internal pull-ups are enabled; pressed reads as logical 1.
 * LED output: drives a suitable MOSFET/transistor gate input, NOT the LED strip directly.
 */
 / {
    halloween_buttons {
        compatible = "gpio-keys";

        button1: button_1 {
            gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Answer 1";
        };

        button2: button_2 {
            gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Answer 2";
        };

        button3: button_3 {
            gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Answer 3";
        };
    };

    /*
     * Station 5 only: 4x3 code keypad, connector order R1..R4, C1..C3.
     * Rows are driven low one at a time; columns use internal pull-ups.
     * EXAMPLE pins, verify they are free/exposed on your board.
     */
    halloween_keypad {
        krow1: krow_1 { compatible = "halloween,gpio"; gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>; };
        krow2: krow_2 { compatible = "halloween,gpio"; gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
        krow3: krow_3 { compatible = "halloween,gpio"; gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>; };
        krow4: krow_4 { compatible = "halloween,gpio"; gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>; };

        kcol1: kcol_1 { compatible = "halloween,gpio"; gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>; };
        kcol2: kcol_2 { compatible = "halloween,gpio"; gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>; };
        kcol3: kcol_3 { compatible = "halloween,gpio"; gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>; };
    };

    halloween_led: halloween_led {
        compatible = "halloween,gpio";
        gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
        label = "LED strip MOSFET enable";
    };
};


/*
 * LCD I2C controller configuration.
 * P1.04 SDA and P1.06 SCL are EXAMPLE pins only. Verify against the
 * exact Pro Micro board pinout and ensure they do not conflict with
 * the board's existing pinctrl configuration.
 */
&pinctrl {
    lcd_i2c0_default: lcd_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
                    <NRF_PSEL(TWIM_SCL, 1, 6)>;
        };
    };

    lcd_i2c0_sleep: lcd_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
                    <NRF_PSEL(TWIM_SCL, 1, 6)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&lcd_i2c0_default>;
    pinctrl-1 = <&lcd_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};


/*
 * DFPlayer Mini on UART1 (9600 8N1), used when CONFIG_HALLOWEEN_DFPLAYER=y.
 *   P1.01 (TX) -> 1k resistor -> DFPlayer RX
 *   P1.02 (RX) <- DFPlayer TX
 * EXAMPLE pins, verify they are free/exposed on your board.
 * The board's uart1_default may exist already, so both groups are set explicitly.
 */
&pinctrl {
    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 1)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 2)>;
            bias-pull-up;
        };
    };
    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 1)>,
                    <NRF_PSEL(UART_RX, 1, 2)>;
            low-power-enable;
        };
    };
};

dfplayer_uart: &uart1 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};
