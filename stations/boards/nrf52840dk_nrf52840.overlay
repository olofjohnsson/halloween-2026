/*
 * nRF52840 DK for testing a station (mainly station 5 with station_5_test.conf).
 * The three answer buttons are external, wired between GPIO and GND on P1.10 / P1.11 / P1.12
 * (override of the board's button1..button3).
 * The station LED output is LED1 (P0.13, active low).
 * The keypad ribbon pins 1..7 connect to P1.01..P1.07; the LCD I2C is the board's i2c0
 * (Arduino header SDA P0.26 / SCL P0.27). Without an LCD the firmware logs an error and continues.
 */
/ {
    halloween_keypad {
        /* HALJIA keypad ribbon pin N is wired to P1.0N: R1=pin2, R2=pin7, R3=pin6, R4=pin4, C1=pin3, C2=pin1, C3=pin5 */
        krow1: krow_1 { compatible = "halloween,gpio"; gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>; };
        krow2: krow_2 { compatible = "halloween,gpio"; gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>; };
        krow3: krow_3 { compatible = "halloween,gpio"; gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>; };
        krow4: krow_4 { compatible = "halloween,gpio"; gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>; };

        kcol1: kcol_1 { compatible = "halloween,gpio"; gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>; };
        kcol2: kcol_2 { compatible = "halloween,gpio"; gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>; };
        kcol3: kcol_3 { compatible = "halloween,gpio"; gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>; };
    };

    halloween_led: halloween_led {
        compatible = "halloween,gpio";
        gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
        label = "LED1 as station LED";
    };
};

&button1 { gpios = <&gpio1 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
&button2 { gpios = <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
&button3 { gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };

/*
 * DFPlayer Mini on UART1 (9600 8N1), used when CONFIG_HALLOWEEN_DFPLAYER=y.
 *   DK P1.08 (TX) -> 1k resistor -> DFPlayer RX
 *   DK P1.09 (RX) <- DFPlayer TX
 * Power the DFPlayer from the DK's 5V and GND pins. P1.01..P1.07 are used by the keypad.
 */
&pinctrl {
    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 8)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 9)>;
            bias-pull-up;
        };
    };
    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 8)>,
                    <NRF_PSEL(UART_RX, 1, 9)>;
            low-power-enable;
        };
    };
};

dfplayer_uart: &uart1 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};
