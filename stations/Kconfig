menu "Halloween station"

config HALLOWEEN_STATION_ID
    int "Station ID (1..5)"
    range 1 5
    default 1
    help
      Station number in the puzzle chain. Station 1 starts the game;
      station 5 generates the final code.

config HALLOWEEN_GATE
    bool "Station 1 waits for the gate station (PIR) to activate it"
    default n
    help
      Without this, station 1 is active as soon as it boots or the game restarts. With it, station 1
      stays waiting until the gate station sends an activation (see gate.c). Only for station 1.

config HALLOWEEN_GATE_STATION
    bool "Build the gate station (PIR sensor) firmware instead of a puzzle station"
    default n
    help
      Use only via station_gate.conf.

if HALLOWEEN_GATE_STATION

config HALLOWEEN_GATE_PLAYER
    int "Music player (1..9) that plays the welcome and wait tracks"
    range 1 9
    default 1

config HALLOWEEN_GATE_WELCOME_TRACK
    int "Welcome/instructions track played when kids arrive"
    range 1 255
    default 10

config HALLOWEEN_GATE_WAIT_FIRST
    int "First wait track, played on motion while a game runs (0 = none)"
    range 0 255
    default 15

config HALLOWEEN_GATE_WAIT_LAST
    int "Last wait track"
    range 0 255
    default 18

config HALLOWEEN_GATE_WELCOME_SECONDS
    int "Length of the welcome track; station 1 is activated this long after it starts"
    range 1 300
    default 45

config HALLOWEEN_GATE_WAIT_COOLDOWN_SECONDS
    int "Minimum time between two wait tracks"
    range 1 600
    default 30

config HALLOWEEN_GATE_NEXT_WELCOME_SECONDS
    int "Delay before the welcome track when motion was seen during the round that just ended"
    range 0 600
    default 10

config HALLOWEEN_GATE_PIR_WARMUP_SECONDS
    int "Ignore the PIR this long after power-up"
    range 0 120
    default 30

config HALLOWEEN_GATE_GAME_TIMEOUT_MINUTES
    int "Treat the game as over after this long without the end of round being heard"
    range 1 240
    default 20

config HALLOWEEN_GATE_STATION1_TRACK
    int "Track station 1 plays locally when the gate activates it (0 = none)"
    range 0 255
    default 0

endif # HALLOWEEN_GATE_STATION

config HALLOWEEN_CORRECT_BUTTON
    int "Correct answer button (1..3)"
    range 1 3
    default 1
    help
      Which of the three answer buttons is correct at this station.

config HALLOWEEN_CODE_DISPLAY_SECONDS
    int "Seconds to show the final code on station 5's LCD (0 = always)"
    default 15
    help
      After this time the LCD hides the code and asks for it; the kids must
      then enter it on station 5's keypad from memory.

config HALLOWEEN_TEST_RELEASE_INTERVAL_S
    int "TEST: station 5 requests a candy release every N seconds (0 = off)"
    default 0
    help
      Skips the puzzle and keypad for testing the dispenser. Use only via
      station_5_test.conf, never for the real game.

config HALLOWEEN_TEST_SKIP_PUZZLE
    bool "TEST: station 5 starts directly at code entry and mirrors the LCD on the UART"
    default n
    help
      Skips the puzzle chain; the code is generated at boot and, after every
      released candy, once an answer button is pressed. Use only via station_5_code_test.conf, never for the real game.

config HALLOWEEN_DFPLAYER
    bool "DFPlayer Mini sound module on UART1"
    select SERIAL
    select UART_INTERRUPT_DRIVEN
    help
      Enables the DFPlayer Mini (see the overlay for the UART pins). Needs a
      board overlay that provides the dfplayer_uart node.

config HALLOWEEN_DFPLAYER_VOLUME
    int "DFPlayer volume (0..30)"
    range 0 30
    default 20
    depends on HALLOWEEN_DFPLAYER

config HALLOWEEN_ACTIVE_TRACK
    int "Track to play on this station when it becomes active (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_CORRECT_TRACK
    int "Track to play on this station on a correct answer (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_CODE_CORRECT_TRACK
    int "Station 5: track to play on this station when the correct code is typed (0 = none)"
    range 0 255
    default 0
    help
      Separate from HALLOWEEN_CORRECT_TRACK, which is used for the correct button press.

config HALLOWEEN_CELEBRATION_SECONDS
    int "Seconds the correct-answer music plays before the next station is activated"
    range 0 120
    default 8

config HALLOWEEN_WRONG_TRACK
    int "Track to play on this station on a wrong answer or wrong code (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_WRONG_TIMEOUT_SECONDS
    int "Seconds all input is ignored after a wrong answer or wrong code"
    range 0 120
    default 5

config HALLOWEEN_NEW_ROUND_DELAY_SECONDS
    int "Station 5: seconds after the correct code before the new round starts"
    range 0 300
    default 40
    help
      The candy is released at the start of the celebration; the new round waits until the
      finale is over, even if the dispenser confirms earlier.

config HALLOWEEN_NEXT_STATION_TRACK
    int "Track the next station plays when this station activates it (0 = none)"
    range 0 255
    default 0
    help
      Sent in the activation message (stations 1-4). The next station needs
      a DFPlayer to play it; stations without one ignore it.

config HALLOWEEN_REMOTE_TRACK
    int "Track to start on another station or the dispenser when this one becomes active (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_REMOTE_TARGET
    int "Target of HALLOWEEN_REMOTE_TRACK (1..5 = station, 0 = candy dispenser)"
    range 0 5
    default 0

config HALLOWEEN_REMOTE_PLAYER
    int "Send HALLOWEEN_REMOTE_TRACK to music player N instead (0 = no, 1..9 = player N)"
    range 0 9
    default 0
    help
      Music players (ESP32-C3, see music-player/) have their own IDs. When this is not 0,
      HALLOWEEN_REMOTE_TARGET is ignored and the track goes to the music player with this ID.

config HALLOWEEN_REMOTE_WRONG_TRACK
    int "Track sent to the remote player/target when a wrong button is pressed (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_REMOTE_CORRECT_TRACK
    int "Track sent to the remote player/target when the correct button is pressed (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_REMOTE_CODE_CORRECT_TRACK
    int "Station 5: track sent to the remote player/target when the correct code is typed (0 = none)"
    range 0 255
    default 0
    help
      Separate from HALLOWEEN_REMOTE_CORRECT_TRACK, which is used for the correct button press.

config HALLOWEEN_REMOTE_DELAYED_TRACK
    int "Track sent to the remote player/target some seconds after the correct button (0 = none)"
    range 0 255
    default 0
    help
      Sent once the delay has passed and the next station has acknowledged the activation
      (the BLE beacon is shared with the activation message). Cancelled when a new round starts.

config HALLOWEEN_REMOTE_DELAYED_SECONDS
    int "Delay in seconds for HALLOWEEN_REMOTE_DELAYED_TRACK"
    range 0 600
    default 10

config HALLOWEEN_LIGHTNING
    bool "Lightning effect on the LED of an active station"
    default y
    help
      A stuttering lightning intro when the station activates, then random short bursts.

config HALLOWEEN_DISPENSER_TRACK
    int "Station 5: track the dispenser plays when asked to release candy (0 = none)"
    range 0 255
    default 0

config HALLOWEEN_TEST_PINGPONG
    bool "TEST: stations 1 and 2 hand over to each other (1 -> 2 -> 1 -> ...)"
    default n
    help
      Station 1 is active from boot; a correct answer deactivates it and
      activates station 2, whose correct answer activates station 1 again.
      Use only via station_1_pingpong.conf / station_2_pingpong.conf.

config HALLOWEEN_TEST_PINGPONG_KEYPAD
    bool "TEST: a fixed code typed on the keypad also passes the activation on"
    depends on HALLOWEEN_TEST_PINGPONG
    help
      The station needs the 4x3 keypad wired as on station 5. '#' submits, '*' clears.

config HALLOWEEN_TEST_PINGPONG_CODE
    string "TEST: fixed keypad code (digits only, avoid 4, 5, 6)"
    default "1237"
    depends on HALLOWEEN_TEST_PINGPONG_KEYPAD

config HALLOWEEN_TEST_IO
    bool "TEST: station 5 shows pressed buttons and keys on the LCD and plays a track on the correct code"
    default n
    help
      Hardware test for station 5 only: no puzzle. Use only via station_5_io_test.conf.

config HALLOWEEN_TEST_IO_CODE
    string "TEST: keys that start the DFPlayer (digits only, avoid 4, 5, 6)"
    default "1237"
    depends on HALLOWEEN_TEST_IO

config HALLOWEEN_TEST_IO_TRACK
    int "TEST: DFPlayer track played when the correct keys are typed"
    range 1 255
    default 1
    depends on HALLOWEEN_TEST_IO

config HALLOWEEN_TEST_IO_NO_KEYPAD
    bool "TEST: do not scan the keypad (to check whether it disturbs the LCD)"
    default n
    depends on HALLOWEEN_TEST_IO

endmenu

source "Kconfig.zephyr"
