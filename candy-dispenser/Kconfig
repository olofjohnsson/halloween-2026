menu "Candy dispenser reporting"

config HALLOWEEN_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
      Leave empty to disable reporting. Set it in the git-ignored
      wifi_secrets.conf (see wifi_secrets.conf.example).

config HALLOWEEN_WIFI_PASSWORD
    string "Wi-Fi password (WPA2/WPA3-Personal, empty for an open network)"
    default ""

config HALLOWEEN_REPORT_HOST
    string "Dispense counter server host or IPv4 address"
    default ""

config HALLOWEEN_REPORT_PORT
    int "Dispense counter server TCP port"
    default 8080

config HALLOWEEN_REPORT_PATH
    string "HTTP path that receives dispense events"
    default "/api/dispense"

config HALLOWEEN_REPORT_API_KEY
    string "API key sent in the X-API-Key header"
    default ""

config HALLOWEEN_REPORT_TEST
    bool "Report test mode: send a fake dispense event every second"
    help
      Exercises the Wi-Fi/web server flow without releasing candy. Keep off
      for normal operation.

endmenu

menu "Candy dispenser flasher"

config HALLOWEEN_FLASH_SECONDS
    int "Seconds the flasher output flashes after a candy release"
    range 1 600
    default 40
    help
      Set this to the length of the final celebration song. Used only when the board
      overlay has a flasher node (MOSFET output).

config HALLOWEEN_FLASH_PERIOD_MS
    int "Flash period in milliseconds (on + off)"
    range 20 10000
    default 500

endmenu

menu "Candy dispenser sound"

config HALLOWEEN_DFPLAYER
    bool "DFPlayer Mini sound module on UART1"
    select SERIAL
    select UART_INTERRUPT_DRIVEN
    help
      Plays tracks requested by the stations (MSG_PLAY_TRACK, or the track
      in the candy release request). Needs a dfplayer_uart node in the
      board overlay.

config HALLOWEEN_DFPLAYER_VOLUME
    int "DFPlayer volume (0..30)"
    range 0 30
    default 20
    depends on HALLOWEEN_DFPLAYER

endmenu

source "Kconfig.zephyr"
