# Copy to wifi_secrets.conf (git-ignored) and fill in.
CONFIG_HALLOWEEN_WIFI_SSID="my-network"
CONFIG_HALLOWEEN_WIFI_PASSWORD="my-password"
CONFIG_HALLOWEEN_REPORT_HOST="192.168.1.50"
CONFIG_HALLOWEEN_REPORT_PORT=8080
CONFIG_HALLOWEEN_REPORT_API_KEY="change-me"
# Uncomment to send a fake dispense every second (no candy released)
#CONFIG_HALLOWEEN_REPORT_TEST=y
