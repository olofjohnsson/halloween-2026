
/*
 * nRF7002 DK (nRF5340 app core). All signals on the Arduino header (1.8 V logic).
 * Candy driver output: P1.06 = LED1, D4 (active-low, inverting transistor stage)
 * Disc switch      : P1.03 (active-low, pull-up)
 * Flasher MOSFET    : P1.07 = LED2, D5 (active-low, inverting stage)
 */

/ {
    /* Disc position switch to GND: active (pin low) at disc position 0. */
    disc_switch: disc_switch {
        compatible = "candy,gpio";
        gpios = <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    candy_actuator: candy_actuator {
        compatible = "candy,gpio";
        gpios = <&gpio1 6 GPIO_ACTIVE_LOW>; /* inverting transistor stage */
        label = "Candy release driver";
    };

    /* MOSFET gate that flashes during the final song. */
    flasher: flasher {
        compatible = "candy,gpio";
        gpios = <&gpio1 7 GPIO_ACTIVE_LOW>; /* inverting stage, like the candy driver */
        label = "Flasher MOSFET";
    };
};

/*
 * DFPlayer Mini on the Arduino serial port (UART1: TX P1.01 = D1, RX P1.00 = D0), 9600 8N1,
 * used when CONFIG_HALLOWEEN_DFPLAYER=y. The Arduino header is 1.8 V logic, so the DFPlayer
 * (3.3 V) needs a level shifter, or at least a divider on its TX line.
 */
dfplayer_uart: &uart1 {
    status = "okay";
    current-speed = <9600>;
};
